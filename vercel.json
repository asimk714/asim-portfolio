{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip install -r requirements.txt && python scripts/build_static.py",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/resume/download/",
      "destination": "/static/assets/resume/Asim-Kumar-Resume.pdf"
    },
    {
      "source": "/resume/download",
      "destination": "/static/assets/resume/Asim-Kumar-Resume.pdf"
    }
  ],
  "headers": [
    {
      "source": "/resume/download/",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Asim-Kumar-Resume.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    },
    {
      "source": "/resume/download",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Asim-Kumar-Resume.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    },
    {
      "source": "/static/assets/resume/Asim-Kumar-Resume.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Asim-Kumar-Resume.pdf\""
        }
      ]
    }
  ]
}
